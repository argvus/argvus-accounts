# Maintainer: William C. Canin <william.costa.canin@gmail.com>
pkgname=argvus-accounts
pkgver=0.1.0
pkgrel=1
pkgdesc="Local user account and avatar manager for the Argvus desktop"
arch=('x86_64')
url="https://github.com/argvus/argvus-accounts"
license=('GPL-3.0-only')
depends=('gcc-libs' 'glibc' 'shadow' 'util-linux' 'polkit')
makedepends=('cargo')
options=('!debug')
source=("${pkgname}-${pkgver}.tar.gz")
sha256sums=()

_source_dir() {
  find "${srcdir}" -mindepth 1 -maxdepth 1 -type d -print -quit
}

_cargo_target_dir() {
  printf '%s' "${CARGO_TARGET_DIR:-$(_source_dir)/target}"
}

build() {
  cd "$(_source_dir)"
  cargo build --workspace --release --locked
}

check() {
  cd "$(_source_dir)"
  cargo test --workspace --release --locked -- --test-threads=4
}

package() {
  cd "$(_source_dir)"
  install -Dm755 "$(_cargo_target_dir)/release/${pkgname}" "${pkgdir}/usr/bin/${pkgname}"
  install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 polkit/50-argvus-accounts.rules "${pkgdir}/usr/share/polkit-1/rules.d/50-argvus-accounts.rules"
}
